# ── AWS Bedrock ──
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# 계정/region에서 허용된 model ID 또는 inference profile ID로 교체 가능
BEDROCK_HAIKU_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0

# ── PostgreSQL (+pgvector, AWS RDS) ──
POSTGRES_HOST=your-db-host.ap-northeast-1.rds.amazonaws.com
POSTGRES_PORT=5432
POSTGRES_DB=venturescout
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://postgres:<password>@your-db-host.ap-northeast-1.rds.amazonaws.com:5432/venturescout?sslmode=verify-full&sslrootcert=db/certs/rds-global-bundle.pem
DB_CONNECT_TIMEOUT=10

# ── 임베딩 (데이터 소스 확정 후) ──
# 영어: AI-Growth-Lab/PatentSBERTa (768d)
# 한국어: KorPatBERT large (768d)
# 폴백: intfloat/multilingual-e5-large (1024d → init.sql 차원 변경 필요)
# DATA_SOURCE="USPTO" -> PatentSBERTa / "KIPRIS" -> KorPatBERT (config.py __post_init__)
DATA_SOURCE=USPTO
EMBEDDING_MODEL=AI-Growth-Lab/PatentSBERTa
EMBEDDING_DIM=768

# ── Track D (api/ui) ──
API_URL=http://localhost:8000     # ui.py가 구독할 FastAPI (compose: http://api:8000)
DEMO_DELAY=0.4                     # 단계 가시성용 인위 지연(초). 실 LLM 붙으면 0
